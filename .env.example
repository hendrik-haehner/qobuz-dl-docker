# Kopiere diese Datei nach .env (wird nicht committet).
# Nur nötig, wenn noch keine config/config.ini existiert:
# Beim ersten Start wird daraus die qobuz-dl-Konfiguration erzeugt.
QOBUZ_EMAIL=
QOBUZ_PASSWORD=

# Optional
# Startwert, bis im Webinterface ein Standard gespeichert wurde
QOBUZ_DEFAULT_QUALITY=6
WEB_PORT=8080

# Musikordner auf dem Host, z. B. die NAS-Freigabe (Synology: /volume1/music)
MUSIC_DIR=./downloads
# Benutzer-/Gruppen-ID, mit der der Container schreibt (auf dem NAS: `id <benutzer>`)
PUID=1000
PGID=1000
