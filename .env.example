# Kopiere diese Datei nach .env (wird nicht committet).

# Passwort für das Webinterface. Ohne Passwort kann jeder im Netz die Seite benutzen.
WEB_PASSWORD=

# Benutzer-/Gruppen-ID, mit der der Container auf die Freigaben schreibt
# (auf dem NAS per SSH: `id <benutzer>`)
PUID=1000
PGID=1000

# Port auf dem NAS. WEB_BIND=127.0.0.1 → nur über einen Reverse-Proxy erreichbar
WEB_PORT=8080
WEB_BIND=0.0.0.0

# Optional: Startwert für die Qualität, bis im Webinterface ein Standard gespeichert wird
QOBUZ_DEFAULT_QUALITY=6

# Optional: Normalerweise meldest du dich im Webinterface bei Qobuz an.
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
